{
  "name": "pofuserver-coder-studio",
  "productName": "Pofuserver Coder Studio",
  "version": "1.2.0",
  "description": "Pofuserver Coder Studio — agente de código em desktop (Electron) que se conecta a qualquer API REST compatível com OpenAI (llama.cpp, Ollama, vLLM, etc.). O agente lê, escreve e apaga arquivos do workspace, executa comandos no terminal com gerenciamento inteligente de processos em segundo plano (sobe servidores/APIs sem travar o chat), aceita anexos de arquivos e renderiza respostas em Markdown com realce de código.",
  "main": "main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prestart": "npm run build",
    "start": "electron --no-sandbox . --ozone-platform=x11",
    "predist:linux": "npm run build",
    "dist:linux": "electron-builder --linux deb",
    "predist:win": "npm run build",
    "dist:win": "electron-builder --win nsis",
    "predist": "npm run build",
    "dist": "electron-builder --linux deb --win nsis"
  },
  "keywords": [
    "code-agent",
    "ai-agent",
    "electron",
    "openai-compatible",
    "llm",
    "llama.cpp",
    "developer-tools",
    "coding-assistant"
  ],
  "author": "Dspofu",
  "githubUrl": "https://github.com/Dspofu/Pofuserver-Code",
  "homepage": "https://github.com/Dspofu/Pofuserver-Code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dspofu/Pofuserver-Code.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13",
    "openai": "^6.46.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.dspofu.pofusercoderstudio",
    "productName": "Pofuserver Coder Studio",
    "copyright": "Copyright © 2026 Dspofu",
    "files": [
      "main.js",
      "preload.cjs",
      "src/**/*",
      "!src/**/*.ts",
      "!**/*.map",
      "index.html",
      "vendor/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Development",
      "maintainer": "Dspofu",
      "executableArgs": [
        "--no-sandbox",
        "--ozone-platform=x11"
      ],
      "icon": "build/icons",
      "desktop": {
        "StartupWMClass": "pofuserver-coder-studio"
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build/license.txt"
    }
  }
}
