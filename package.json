{
  "name": "pofu-code-studio",
  "productName": "Pofu Code Studio",
  "version": "1.7.0",
  "description": "Agente de código em desktop (Electron) para qualquer API compatível com OpenAI: lê e edita o projeto, roda comandos e servidores em segundo plano e valida o que faz.",
  "main": "out/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-websearch.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prestart": "npm run build",
    "start": "electron --no-sandbox . --ozone-platform=x11",
    "predist:linux": "npm run build",
    "dist:linux": "electron-builder --linux deb",
    "predist:fedora": "npm run build",
    "dist:fedora": "electron-builder --linux rpm",
    "predist:win": "npm run build",
    "dist:win": "electron-builder --win nsis",
    "predist": "npm run build",
    "dist": "electron-builder --linux deb --win nsis",
    "test": "npm run build && node --test scripts/tool-results.test.mjs scripts/slash-commands.test.mjs scripts/mentions-paths.test.mjs scripts/providers.test.mjs scripts/edit-diagnostics.test.mjs scripts/edit-match.test.mjs scripts/tool-output.test.mjs scripts/package-metadata.test.mjs scripts/loop-guard.test.mjs scripts/outline.test.mjs scripts/mcp.test.mjs scripts/consumption.test.mjs scripts/remote-control.test.mjs scripts/remote-history.test.mjs scripts/model-vision.test.mjs scripts/computer.test.mjs scripts/updater.test.mjs",
    "test:consumption": "npm run build && node scripts/run-consumption-tests.cjs",
    "test:integration": "npm run build && node scripts/run-electron-tests.cjs",
    "test:reconnect": "npm run build && node scripts/run-reconnect-tests.cjs",
    "test:computer": "npm run build && node scripts/run-computer-tests.cjs",
    "test:update": "npm run build && node scripts/run-update-tests.cjs",
    "test:startup": "npm run build && node scripts/run-startup-tests.cjs",
    "test:api": "npm run build && node scripts/test-api.mjs",
    "test:agent": "npm run build && node scripts/run-agent-tests.cjs",
    "test:agent:long": "npm run build && node scripts/run-electron-script.cjs scripts/test-agente-maratona.cjs",
    "test:agent:quality": "npm run build && node scripts/run-electron-script.cjs scripts/test-agente-qualidade.cjs",
    "test:computer:real": "npm run build && node scripts/run-electron-script.cjs scripts/test-computador-real.cjs",
    "test:vision": "npm run build && node scripts/run-vision-tests.cjs"
  },
  "keywords": [
    "code-agent",
    "ai-agent",
    "electron",
    "openai-compatible",
    "llm",
    "llama.cpp",
    "developer-tools",
    "coding-assistant"
  ],
  "author": "Dspofu",
  "githubUrl": "https://github.com/Dspofu/Pofu-Code-Studio",
  "homepage": "https://github.com/Dspofu/Pofu-Code-Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dspofu/Pofu-Code-Studio.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13",
    "openai": "^6.46.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.dspofu.pofusercoderstudio",
    "productName": "Pofu Code Studio",
    "copyright": "Copyright © 2026 Dspofu",
    "files": [
      "out/**/*",
      "!out/*.map",
      "index.html",
      "vendor/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Development",
      "maintainer": "Dspofu",
      "executableArgs": [
        "--no-sandbox",
        "--ozone-platform=x11"
      ],
      "icon": "build/icons",
      "desktop": {
        "StartupWMClass": "pofu-code-studio"
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXtst",
        "libXScrnSaver",
        "xdg-utils",
        "at-spi2-core",
        "libuuid"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build/license.txt"
    }
  }
}
